@inject ILocalStorageService LocalStorageService
@inject CustomAuthStateProvider CustomAuthStateProvider

<AuthorizeView>
    <Authorized>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => OnToggle.InvokeAsync())" />
            <MudSpacer />
            <MudText Typo="Typo.h6">MRA Assets Management</MudText>
            <MudSpacer />
            <MudChip Color="Color.Primary" Variant="Variant.Filled">
                @context.User.Identity?.Name
            </MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Edge="Edge.End" OnClick="@Logout" />
        </MudAppBar>
    </Authorized>
    <NotAuthorized>
        <MudAppBar Elevation="1">
            <MudSpacer />
            <MudText Typo="Typo.h6">MRA Assets Management</MudText>
            <MudSpacer />
        </MudAppBar>
    </NotAuthorized>
</AuthorizeView>

@code
{
    [Parameter]
    public EventCallback OnToggle { get; set; }

    private async Task Logout()
    {
        await CustomAuthStateProvider.LogoutUser();
    }
}