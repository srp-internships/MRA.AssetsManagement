@page "/employees"
@page "/employees/{userName}"
@attribute [Authorize]
@layout SettingsLayout
@inject IEmployeesService EmployeesService
@inject IMenuItemService MenuItemService
@inject IAssetTypesService AssetTypesService
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@using MudBlazor


@if (_loading)
{
    <MudSkeleton Class="mt-3" SkeletonType="SkeletonType.Rectangle" Animation=Animation.Wave Width="400px" Height="40px" />
    <MudSkeleton Class="mt-3" SkeletonType="SkeletonType.Rectangle" Animation=Animation.Wave Width="400px" Height="40px" />
    <MudSkeleton Class="mt-3" SkeletonType="SkeletonType.Rectangle" Animation=Animation.Wave Width="400px" Height="40px" />
}
else if (_isAdmin)
{
    <MudSelect T="GetEmployee" Label="Select Employee" @bind-Value="_selectedEmployee" Dense="true" Style="width:300px; margin-bottom: 24px;" @bind-Value:event="onchange">
        @foreach (var emp in _allEmployees)
        {
            <MudSelectItem Value="@emp">@emp.UserName (@emp.Email)</MudSelectItem>
        }
    </MudSelect>
    @if (_editEmployee != null)
    {
        <EditForm Model="_editEmployee" OnValidSubmit="UpdateEmployee">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_editEmployee.FirstName" Label="First name" Margin="Margin.Dense" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_editEmployee.LastName" Label="Last name" Margin="Margin.Dense" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_editEmployee.UserName" Label="Username" Margin="Margin.Dense" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_editEmployee.Email" Label="Email" InputType="InputType.Email" Margin="Margin.Dense" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_editEmployee.PhoneNumber" Label="Phone" Margin="Margin.Dense" Variant="Variant.Outlined" />
            <MudSwitch @bind-Checked="_editEmployee.CanLogin" Color="Color.Primary" Label="Allow this user to log in" Class="mt-2" />
            @if (!_editEmployee.CanLogin)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-2">
                    This user will not be able to log in until re-enabled.
                </MudAlert>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" ButtonType="ButtonType.Submit">Save</MudButton>
        </EditForm>
    }
}
else if (_editEmployee != null)
{
    <EditForm Model="_editEmployee" OnValidSubmit="UpdateEmployee">
        <DataAnnotationsValidator />
        <MudTextField @bind-Value="_editEmployee.FirstName" Label="First name" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_editEmployee.LastName" Label="Last name" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_editEmployee.UserName" Label="Username" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_editEmployee.Email" Label="Email" InputType="InputType.Email" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_editEmployee.PhoneNumber" Label="Phone" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudSwitch @bind-Checked="_editEmployee.CanLogin" Color="Color.Primary" Label="Allow this user to log in" Class="mt-2" />
        @if (!_editEmployee.CanLogin)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-2">
                This user will not be able to log in until re-enabled.
            </MudAlert>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" ButtonType="ButtonType.Submit">Save</MudButton>
    </EditForm>
}

@code {
    
    [Parameter] public string? UserName { get; set; }
    private bool _loading = false;
    private string _currentUserName = "";
    private bool _isAdmin = false;
    private List<GetEmployee> _allEmployees = new();
    private GetEmployee? _selectedEmployee
    {
        get => _selectedEmployeeBacking;
        set
        {
            if (_selectedEmployeeBacking != value)
            {
                _selectedEmployeeBacking = value;
                if (value != null)
                    _ = LoadEmployeeForEdit(value.UserName);
            }
        }
    }
    private GetEmployee? _selectedEmployeeBacking;
    private UpdateEmployeeRequest? _editEmployee;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserName = user.Identity?.Name ?? "";
        _isAdmin = user.IsInRole("Administrator") || user.Claims.Any(c => c.Type.Contains("role") && c.Value == "Administrator");
        if (_isAdmin)
        {
            _allEmployees = (await EmployeesService.GetEmployees()).ToList();
            if (_allEmployees.Any())
            {
                _selectedEmployee = _allEmployees.First();
                await LoadEmployeeForEdit(_selectedEmployee.UserName);
            }
        }
        else
        {
            if (!string.IsNullOrEmpty(_currentUserName))
            {
                await LoadEmployeeForEdit(_currentUserName);
            }
        }
        _loading = false;
    }

    private async Task LoadEmployeeForEdit(string userName)
    {
        var employee = await EmployeesService.GetEmployeeByUserName(userName);
        _editEmployee = new UpdateEmployeeRequest
        {
            Id = employee.Id ?? string.Empty,
            FirstName = employee.FirstName,
            LastName = employee.LastName,
            UserName = employee.UserName,
            Email = employee.Email,
            PhoneNumber = employee.PhoneNumber,
            CanLogin = employee.CanLogin
        };
        StateHasChanged();
    }

    private async Task UpdateEmployee()
    {
        if (_editEmployee == null || string.IsNullOrWhiteSpace(_editEmployee.Id))
            return;
        await EmployeesService.Update(_editEmployee);
        if (_isAdmin && _selectedEmployee != null)
        {
            // Refresh the selected employee's info after update
            await LoadEmployeeForEdit(_selectedEmployee.UserName);
        }
    }
}
