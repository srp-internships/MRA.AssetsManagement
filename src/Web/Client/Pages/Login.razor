@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using MRA.AssetsManagement.Web.Client.Services.AuthService
@using Blazored.LocalStorage
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login - Assets Management</PageTitle>

<style>
    .login-bg {
        min-height: 100vh;
        background: white;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 12vh;
    }
    .login-card {
        width: 100%;
        max-width: 400px;
        border-radius: 22px;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.18);
        padding: 40px 32px 32px 32px;
        background: linear-gradient(135deg, #fff 80%, #f3f6fa 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .login-logo {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 18px;
    }
    .login-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 6px;
        color: #222;
        text-align: center;
    }
    .login-subtitle {
        font-size: 1rem;
        color: #666;
        margin-bottom: 24px;
        text-align: center;
    }
    .login-btn {
        margin-top: 18px;
        font-size: 1.1rem;
        padding: 12px 0;
        border-radius: 8px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }
</style>

<div class="login-bg">
    <MudCard Class="login-card" Elevation="12">
        <div class="login-logo">
            <MudAvatar Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Primary" />
        </div>
        <div class="login-title">Sign in</div>
        <div class="login-subtitle">Access your MRA Assets Management account</div>
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" style="width: 100%;">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="loginModel.Username" 
                         Label="Username" 
                         Variant="Variant.Outlined" 
                         Margin="Margin.Dense"
                         FullWidth="true"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Person"
                         Style="margin-bottom: 18px; border-radius: 8px;" />
            <MudTextField @bind-Value="loginModel.Password" 
                         Label="Password" 
                         Variant="Variant.Outlined" 
                         Margin="Margin.Dense"
                         FullWidth="true"
                         InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                         StartAdornmentIcon="@Icons.Material.Filled.Lock"
                         Adornment="Adornment.End"
                         AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                         OnAdornmentClick="TogglePasswordVisibility"
                         T="string"
                         Style="margin-bottom: 10px; border-radius: 8px;" />
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Style="margin-bottom: 14px;">
                    @errorMessage
                </MudAlert>
            }
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@isLoading"
                       Class="login-btn">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Logging in...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                    <span>Login</span>
                }
            </MudButton>
        </EditForm>
    </MudCard>
</div>

@code {
    private LoginRequest loginModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool _showPassword = false;

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleLogin()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var httpClient = HttpClientFactory.CreateClient("API");
            var response = await httpClient.PostAsJsonAsync("api/auth/login", loginModel);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (result != null)
                {
                    var tokenResponse = new JwtTokenResponse
                    {
                        AccessToken = result.AccessToken,
                        RefreshToken = result.RefreshToken,
                        AccessTokenValidateTo = result.ExpiresAt
                    };

                    await LocalStorage.SetItemAsync("authToken", tokenResponse);
                    await LocalStorage.SetItemAsync("userName", result.Username);

                    var authStateProvider = (CustomAuthStateProvider)AuthStateProvider;
                    authStateProvider.NotifyAuthenticationStateChanged();

                    await Task.Delay(500);
                    Navigation.NavigateTo("/", forceLoad: true);
                }
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = error?.Message ?? "Login failed. Please try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginRequest
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = string.Empty;
        
        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public string AccessToken { get; set; } = string.Empty;
        public string RefreshToken { get; set; } = string.Empty;
        public DateTime ExpiresAt { get; set; }
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }

    public class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}